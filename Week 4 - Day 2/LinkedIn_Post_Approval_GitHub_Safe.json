      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an experienced LinkedIn content editor.\n\nReview and improve the following LinkedIn post:\n\n{{ $json.output }}\n\nReview criteria:\n1. Hook: Does the opening capture attention?\n2. Clarity: Is the message clear and engaging?\n3. CTA: Does the post encourage meaningful engagement?\n\nInstructions:\n- Internally score Hook, Clarity, and CTA out of 10.\n- Rewrite the weakest parts to improve quality.\n- Maintain a professional, conversational tone.\n- Keep the post between 120 and 150 words.\n- Include one clear CTA and a maximum of 3 hashtags.\n- Preserve the original topic and factual accuracy.\n- Return ONLY the final improved LinkedIn post.\n- Do not include scores, feedback, or explanations.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
