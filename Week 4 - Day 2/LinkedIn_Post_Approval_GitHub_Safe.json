    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional LinkedIn content writer.\n\nWrite a compelling LinkedIn post about:\n{{ $json.Topic }}\n\nRequirements:\n- Start with an attention-grabbing hook.\n- Write between 120 and 150 words.\n- Use a professional yet conversational tone.\n- Use short paragraphs for readability.\n- Include one clear call to action (CTA).\n- Include a maximum of 3 relevant hashtags.\n- Avoid exaggerated claims and unnecessary emojis.\n- Return only the finished LinkedIn post.",
        "options": {}
      },
